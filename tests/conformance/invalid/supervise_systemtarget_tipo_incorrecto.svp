-- supervise_systemtarget_tipo_incorrecto.svp — SystemTarget debe contener CompositionGraph

codomain K3 = { APTO, NO_APTO, INDETERMINADO };
output_semantics Klin { APTO -> "ok"; NO_APTO -> "no"; INDETERMINADO -> "u"; }

cellspec CBase { b: 3; codomain: K3; semantics: Klin; role: Base; }
cellspec CMeta { b: 3; codomain: K3; semantics: Klin; role: Supervisor; }

cellstate SBase {
  spec: CBase;
  vector: [Zero, One, U, Zero, Zero, One, U, Zero, One];
}

cellstate SMeta {
  spec: CMeta;
  vector: [Zero, Zero, Zero, Zero, Zero, Zero, Zero, Zero, Zero];
}

let EBase = evaluate(SBase);
let EMeta = evaluate(SMeta);
let SV1 = supervise(EMeta, target: SystemTarget(EBase));
