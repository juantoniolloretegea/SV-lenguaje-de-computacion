-- Obligación E011: FUERA no pertenece a KOut={OK,NO_OK}.
-- Debe alcanzar la validación semántica: AdmissibilityTable T1: salida fuera de codominio.
-- El código literal E011 sigue pendiente de emisión estructurada en Rust (DFL-001).

codomain KIn = { A, B };
codomain KOut = { OK, NO_OK };

admissibility_table T1 {
  input_codomains: [KIn];
  output_codomain: KOut;
  table: {
    (A) -> OK;
    (B) -> FUERA;
  }
}
