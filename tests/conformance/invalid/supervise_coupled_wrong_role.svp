-- supervise_coupled_wrong_role.svp — EvalResult acoplado procedente de célula no Supervisor

codomain K3 = { APTO, NO_APTO, INDETERMINADO };
output_semantics Klin { APTO -> "ok"; NO_APTO -> "no"; INDETERMINADO -> "u"; }

cellspec CBase {
  b: 3;
  codomain: K3;
  semantics: Klin;
  role: Base;
}

coupledspec CCBase {
  cell: CBase;
  bridges: [];
}

coupledstate CSBase {
  spec: CCBase;
  base_vector: [Zero, Zero, Zero, Zero, Zero, Zero, Zero, Zero, Zero];
  updated_vector: [Zero, Zero, Zero, Zero, Zero, Zero, Zero, Zero, Zero];
}

let EBase = evaluate(CSBase);

-- Debe fallar con E211: EBase sí es EvalResult, pero procede de CBase con rol Base.
let SV_bad = supervise(EBase, target: CellTarget(EBase));
