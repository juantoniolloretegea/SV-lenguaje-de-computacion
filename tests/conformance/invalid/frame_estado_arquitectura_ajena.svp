-- Debe fallar con E308: todo CoupledState del Frame debe corresponder a un nodo de su arquitectura.
codomain K3 = { A, B };
output_semantics Sem { A -> "a"; B -> "b"; }
cellspec C1 { b: 3; codomain: K3; semantics: Sem; role: Base; }
cellspec C2 { b: 3; codomain: K3; semantics: Sem; role: Base; }
coupledspec CC1 { cell: C1; bridges: [1]; }
coupledspec CC2 { cell: C2; bridges: [1]; }
coupledstate S2 { spec: CC2; base_vector: [U,U,U,U,U,U,U,U,U]; updated_vector: [U,U,U,U,U,U,U,U,U]; }
semantic_relation R { kind: DeclaredRelation; constraints: [Local]; }
graph G { nodes: [CC1]; edges: []; relation: R; regime: Simple; }
frame F { index: 1; architecture: G; cell_states: [S2]; eval_results: []; gate_results: []; supervision: []; criticalities: []; }
