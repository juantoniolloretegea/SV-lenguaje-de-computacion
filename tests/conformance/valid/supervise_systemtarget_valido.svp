-- supervise_systemtarget_valido.svp — Supervisión de un grafo de composición

codomain K3 = { APTO, NO_APTO, INDETERMINADO };

output_semantics Klin {
  APTO -> "ok";
  NO_APTO -> "no";
  INDETERMINADO -> "u";
}

cellspec C1 {
  b: 3;
  codomain: K3;
  semantics: Klin;
  role: Base;
}

cellspec C2 {
  b: 3;
  codomain: K3;
  semantics: Klin;
  role: Base;
}

cellspec CMeta {
  b: 3;
  codomain: K3;
  semantics: Klin;
  role: Supervisor;
}

coupledspec CC1 {
  cell: C1;
  bridges: [3];
}

coupledspec CC2 {
  cell: C2;
  bridges: [3];
}

connector Phi1 {
  source_codomain: K3;
  target_position: 3;
  mapping: {
    APTO -> Zero;
    NO_APTO -> One;
    INDETERMINADO -> U;
  }
}

semantic_relation R_serie {
  kind: DeclaredRelation;
  constraints: [ProfilaxisRiesgo];
}

graph G1 {
  nodes: [CC1, CC2];
  edges: [edge(source: CC1, target: CC2, position: 3, connector: Phi1)];
  relation: R_serie;
  regime: Simple;
}

cellstate SMeta {
  spec: CMeta;
  vector: [Zero, Zero, Zero, Zero, Zero, Zero, Zero, Zero, Zero];
}

let EMeta = evaluate(SMeta);
let SVsys = supervise(EMeta, target: SystemTarget(G1));
