-- transition_data_events.svp — TransitionData con sucesos e induced_parameters

codominio K3 = { APTO, NO_APTO, INDETERMINADO };
semántica_de_salida Klin { APTO -> "ok"; NO_APTO -> "no"; INDETERMINADO -> "u"; }

especificación_de_celda C1 { b: 3; codominio: K3; semántica: Klin; rol: Base; }

horizonte H1 {
  arquitectura: Arch1;
  sucesos: [CambioProfilaxis, NuevoCultivo];
}

datos_de_transición TD1 {
  referencia_de_horizonte: H1;
  sucesos: [(CambioProfilaxis, Uno), (NuevoCultivo, Cero)];
  parámetros_inducidos: [(C1, 3, Uno), (C1, 7, Cero)];
}
