coupledspec Y { cell: C; bridges: [1]; }
coupledspec Z { cell: C; bridges: [1]; }
coupledstate V { spec: X; base_vector: [U,U,U,U,U,U,U,U,U]; updated_vector: [1,U,U,U,U,U,U,U,U]; }
