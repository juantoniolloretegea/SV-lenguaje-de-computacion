+#![forbid(unsafe_code)]
+//! Conductor de ensayo público: la referencia y la vigencia proceden del montaje fijado.
+//! No constituye recepción profesional ni concede permiso. stdout sólo usa EntregaLiteral.
+use std::{io::{Read,Write},fs::File};
+fn causa(e:g1::FalloEntrega)->&'static str { use g1::FalloEntrega::*;match e {
+ ContenidoDistinto=>"CONTENIDO_DISTINTO",Integridad=>"INTEGRIDAD",Limite=>"LIMITE",
+ YaIntentada=>"YA_INTENTADA",Custodia(_)=>"CUSTODIA"
+}}
+fn main(){if let Err(e)=run(){eprintln!("{{\"estado\":\"RECHAZADA\",\"causa\":\"{}\"}}",e);std::process::exit(2);}}
+fn run()->Result<(),&'static str>{
+ let a:Vec<_>=std::env::args().collect();if a.len()!=3{return Err("ARGUMENTOS")}
+ let mut c=g1::Custodio::nuevo(g1::Realizacion{fuentes_sha256:[0;32],binario_sha256:[0;32]}).map_err(|_|"CUSTODIA")?;
+ // Ceros = metadatos no acreditados por este conductor. La campaña guarda las huellas reales.
+ let mut input=File::open(&a[1]).map_err(|_|"ENTRADA")?;
+ let h=c.abrir(&mut input,true).map_err(|_|"CUSTODIA")?;
+ c.ejecutar_a(&h).map_err(|_|"CUSTODIA")?;
+ let mut proposed=Vec::new();let mut file=File::open(&a[2]).map_err(|_|"ENTRADA")?.take(4145);
+ file.read_to_end(&mut proposed).map_err(|_|"ENTRADA")?;
+ c.comprobar_entrega(&h,&proposed).map_err(causa)?;
+ let e=c.entrega(&h).map_err(causa)?;
+ std::io::stdout().lock().write_all(e.cuerpo()).map_err(|_|"SALIDA")?;Ok(())
+}
