+// Identidad de instancia del ensayo intra-proceso. No es autoridad, tiempo ni
+// identidad durable. No se expone ni se reconstruye desde el texto de la traza.
+static NEXT_CONTINUITY: AtomicU64 = AtomicU64::new(1);
+fn allocate_continuity(counter: &AtomicU64) -> Option<u64> {
+    counter.fetch_update(Ordering::Relaxed, Ordering::Relaxed,
+        |n| n.checked_add(1)).ok()
+}
 
